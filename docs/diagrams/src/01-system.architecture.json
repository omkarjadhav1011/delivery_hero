  "cards": [
    {
      "dot": "cyan",
      "title": "Clients",
      "items": [
        "One static Next.js export with three areas: /join, /screen, /admin",
        "Phones and projector hold a STOMP socket; admin uses REST"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend",
      "items": [
        "Spring Boot 4.1 on Java 21, one game open at a time",
        "Engine threads never touch the DB or network directly"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "Answers are scored on the server and never sent early",
        "Deploys stop when a game is in progress"
      ]
